@model Warehouse_25DH110487.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm mới";
}

<h2>THÊM SẢN PHẨM MỚI</h2>
<hr />

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="max-width: 600px;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group" style="margin-bottom: 15px;">
            <label class="control-label">Tên sản phẩm <span style="color:red">*</span></label>
            @Html.TextBoxFor(model => model.ProductName, new { @class = "form-control", placeholder = "Nhập tên sản phẩm..." })
            @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label class="control-label">Danh mục <span style="color:red">*</span></label>
            @Html.TextBoxFor(model => model.Category, new { @class = "form-control", placeholder = "Ví dụ: Điện tử, Phụ kiện..." })
            @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label class="control-label">Đơn giá (VNĐ) <span style="color:red">*</span></label>
            @Html.TextBoxFor(model => model.Price, new { @class = "form-control", type = "number", step = "any", placeholder = "Nhập đơn giá > 0" })
            @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
            <label class="control-label">Số lượng ban đầu <span style="color:red">*</span></label>
            @Html.TextBoxFor(model => model.Quantity, new { @class = "form-control", type = "number", placeholder = "Nhập số lượng >= 0" })
            @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <input type="submit" value="Lưu sản phẩm" class="btn btn-primary" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default", style = "margin-left: 10px;" })
        </div>
    </div>
}